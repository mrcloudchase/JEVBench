# Copy to .env (git-ignored). Variables already in the environment win.
PROVIDER=typesafe                                   # typesafe, openai, or "module:Class"
PROVIDER_API_KEY=sk-...                             # or the vendor's own: TYPESAFE_API_KEY, OPENAI_API_KEY
# Optional when the provider class has defaults:
# PROVIDER_URL=https://api.typesafe.ai/v1/systemone
# PROVIDER_MODEL=jev-latest
